# Copy to backend/.env (already loaded automatically by backend/api/main.py).
# Leave any line commented out / absent to keep that provider "not connected" —
# the site stays honest about it either way (see /api/providers and the
# "Что подключено прямо сейчас" panel in Реальный поиск).
#
# Only put credentials here that a provider issued to YOU directly through
# their own registration/sandbox process. Nothing here should ever be a key
# found on the open web, scraped from another site, or shared by anyone else.

# RateHawk — https://www.ratehawk.com/lp/en/API/ (registration + certification)
# Once set, RateHawk is queried live in both "Реальный поиск" and "API тест".
# RATEHAWK_SANDBOX_KEY_ID=
# RATEHAWK_SANDBOX_KEY=

# Duffel — https://duffel.com/docs/api/overview/test-mode (free, instant test token)
# Must start with duffel_test_ — only testable today via the "API тест" tab.
# DUFFEL_TOKEN=duffel_test_...

# Hotelbeds / HBX Evaluation — https://developer.hotelbeds.com/documentation/getting-started/
# HOTELBEDS_API_KEY=
# HOTELBEDS_SECRET=

# DidaTravel — dedicated sandbox account (shared test account was retired)
# https://apidoc.didatravel.com/booking-api/price-search.html
# DIDA_CLIENT_ID=
# DIDA_LICENSE_KEY=
# DIDA_ENVIRONMENT=sandbox

# Tourvisor — https://api.tourvisor.ru/search/docs (trial: 300 requests/day)
# TOURVISOR_TOKEN=
# TOURVISOR_ACCESS_MODE=trial

# Optional infra
# REDIS_URL=
